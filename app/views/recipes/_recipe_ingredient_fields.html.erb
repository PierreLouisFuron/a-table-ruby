<div class="nested-fields row mb-2 align-items-center">
  <div class="ingredients col-sm-4 d-flex align-items-center">
    <span class="drag-handle text-secondary me-2" title="Drag to reorder"><i class="fa fa-grip-vertical"></i></span>
    <%= f.hidden_field :position, class: 'position-field' %>
    <div class="flex-grow-1">
      <%= f.fields_for :ingredient do |ingredient| %>
        <%= render "ingredient_fields", f: ingredient %>
      <% end %>
    </div>
  </div>

  <div class="col-sm-2">
    <%= f.text_field :quantity, placeholder: '30.0', class:'form-control'  %>
  </div>

  <div class="col-sm-3">
    <%= f.text_field :unit, placeholder: 'Kg, cL, Spoons, Gallons, ...', class:'form-control' %>
  </div>  
  
  <div class="col-sm-2">
    <%= f.check_box :is_optional, class:'form-check-input' %>
    <%= f.label :is_optional %>
  </div>

  <div class="col-sm-1">
    <%= link_to_remove_association f, class: 'btn btn-danger form-control' do %><i class="fa fa-trash"></i><% end %>
  </div>
  
</div>
