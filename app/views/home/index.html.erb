<div class="row">

  <% if @upcoming_meals.empty? %>
    <div class="col-12">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">No upcoming meals</h5>
          <%= link_to menus_path, class: 'btn btn-primary' do %>
            Go to menus <i class="fa fa-arrow-right ms-2"></i>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <h1>On Today's Menu </h1>
    <%= render 'meals', meals: @meals_of_the_day, date: Date.today %>

    <h1>And Tomorrow </h1>
    <%= render 'meals', meals: @meals_of_tomorrow, date: Date.tomorrow %>


    <div class="col-12">
      <h1> Other Upcoming Deliciously Tasty Recipes </h1>
      <% if @recipes_of_the_future.count == 0 %>
      <h4>Nothing at the moment 😢 </h4>
      <% else %>
        <div class="list-group">
          <% @recipes_of_the_future.each do |recipe| %>
            <%= link_to recipe, class: "list-group-item" do %>
              <%= recipe.name %>
            <% end %>
            <%# image_tag recipe.get_square_thumbnail, class: 'card-img-top bg-danger', alt: 'menu' %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="col-12 mt-3">
    <div class="d-flex align-items-center gap-2 mb-2">
      <h5 class="mb-0">Quick and dirty</h5>
      <%#<button class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-rotate-right"></i></button> %>
      <%= link_to suggestions_quick_and_dirty_path, data: { turbo_frame: "quick_and_dirty" }, class: "btn btn-outline-primary btn-sm" do %><i class="fa-solid fa-rotate-right"></i><% end %>
    </div>
    <%= render 'recipe_suggestions', recipes: @quick_and_dirty_recipes %>
  </div>

  <div class="col-12 mt-3">
    <div class="d-flex align-items-center gap-2 mb-2">
      <h5 class="mb-0">Seasonal Suggestions</h5>
      <button class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-rotate-right"></i></button>
    </div>
    <div class="card-group">
      <div class="card">
        <%= lazy_image_tag 'placeholders/placeholder.png', class: 'card-img-top', alt: 'recipe suggestion' %>
        <div class="card-body">
          <h5 class="card-title">Card title</h5>
        </div>
      </div>
      <div class="card">
        <%= lazy_image_tag 'placeholders/placeholder.png', class: 'card-img-top', alt: 'recipe suggestion' %>
        <div class="card-body">
          <h5 class="card-title">Card title</h5>
        </div>
      </div>
      <div class="card">
        <%= lazy_image_tag 'placeholders/placeholder.png', class: 'card-img-top', alt: 'recipe suggestion' %>
        <div class="card-body">
          <h5 class="card-title">Card title</h5>
        </div>
      </div>
      <div class="card">
        <%= lazy_image_tag 'placeholders/placeholder.png', class: 'card-img-top', alt: 'recipe suggestion' %>
        <div class="card-body">
          <h5 class="card-title">Card title</h5>
        </div>
      </div>
      <div class="card">
        <%= lazy_image_tag 'placeholders/placeholder.png', class: 'card-img-top', alt: 'recipe suggestion' %>
        <div class="card-body">
          <h5 class="card-title">Card title</h5>
        </div>
      </div>
    </div>
  </div>

</div>
