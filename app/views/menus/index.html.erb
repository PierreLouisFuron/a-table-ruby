<% if notice %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<h1>Menus</h1>

<div class="d-flex justify-content-between">
  <div>
    <%= form_with(model: Menu.new) do |form| %>
      <div class="row">
        <div class="col-auto">
          <%= form.date_field :start_date, class: 'form-control col-auto' %>
        </div>
        <div class="col-auto">
          <%= form.date_field :end_date, class: 'form-control col-auto' %>
        </div>
        <div class="col-auto">
          <div class="btn-group">
            <%= form.submit "Create Menu", class:'btn btn-primary' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="dropdown dropdown-menu-end">
    <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
      Quick Menu
    </button>
    <ul class="dropdown-menu">
      <li><%= button_to 'Just for today', '#', params: { menu: { start_date: DateTime.now, end_date: DateTime.now } }, class: 'dropdown-item' %></li>
      <li><%= button_to 'The next 2 days', '#', params: { menu: { start_date: DateTime.now, end_date: DateTime.now + 1 } }, class: 'dropdown-item' %></li>
      <li><%= button_to 'The next 3 days', '#', params: { menu: { start_date: DateTime.now, end_date: DateTime.now + 2 } }, class: 'dropdown-item' %></li>
      <li><%= button_to 'The next 5 days', '#', params: { menu: { start_date: DateTime.now, end_date: DateTime.now + 4} }, class: 'dropdown-item' %></li>
      <li><%= button_to 'The next week', '#', params: { menu: { start_date: DateTime.now, end_date: DateTime.now + 6} }, class: 'dropdown-item' %></li>
    </ul>
  </div>
</div>

<%= render @menus %>

<h1 class="mt-3">Latest Expired Menus</h1>
<div class="accordion expired-menus shadow-sm rounded" id="expiredMenusAccordion">

  <% expired_menus = Menu.expired.limit(5).reject { |menu| menu.recipes.empty? } %>
  <% expired_menus.each_with_index do |menu, index| %>
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_<%= menu.id %>" aria-expanded="false" aria-controls="collapse_<%= menu.id %>">
            From <%= menu.start_date.strftime("%A, %B %d") %> to <%= menu.end_date.strftime("%A, %B %d") %> 
          </button>
        </h2>
        <div id="collapse_<%= menu.id %>" class="accordion-collapse collapse<%= ' rounded-bottom overflow-hidden' if index == expired_menus.size - 1 %>" data-bs-parent="#expiredMenusAccordion">
          <div class="accordion-body p-0">
            <ul class="list-group list-group-flush">
              <% menu.recipes.each do |recipe| %>
                <%= link_to recipe, class: "list-group-item p-0" do %>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex justify-content-start align-items-center">
                      <div class="ratio ratio-4x3 flex-shrink-0 me-3 lazy-image" style="width: 70px;" data-controller="lazy-image">
                        <%= image_tag recipe.get_tiny_cover_thumbnail, class: 'object-fit-cover', alt: 'menu', loading: 'lazy', data: { lazy_image_target: 'img', action: 'load->lazy-image#reveal' } %>
                      </div>
                      <%= recipe.name %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
  <% end%>
</div>
